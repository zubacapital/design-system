{
  "name": "@zuba/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Shared W3C DTCG design tokens for zuba apps, built with Style Dictionary.",
  "license": "UNLICENSED",
  "exports": {
    "./css": "./dist/css/tokens.css",
    "./tokens/*": "./tokens/*"
  },
  "scripts": {
    "build": "style-dictionary build --config style-dictionary.config.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "style-dictionary": "5.6.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.8.1"
}
