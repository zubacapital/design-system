{
  "color": {
    "$type": "color",
    "$description": "Raw palette. Steps follow a 50–900 lightness scale; only the steps the site actually uses are defined.",
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "black": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "hex": "#000000"
      }
    },
    "navy": {
      "50": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.949, 0.9765, 0.9882],
          "hex": "#f2f9fc"
        }
      },
      "200": {
        "$value": {
          "colorSpace": "oklch",
          "components": [0.8614, 0.018, 229.04],
          "hex": "#c6d4db"
        },
        "$description": "Authored in OKLCH; hex is the sRGB fallback."
      },
      "900": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0627, 0.1686, 0.2196],
          "hex": "#102b38"
        },
        "$description": "Zuba navy."
      },
      "$description": "Brand hue."
    },
    "teal": {
      "600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2, 0.5412, 0.6],
          "hex": "#338a99"
        }
      }
    },
    "slate": {
      "50": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9843, 0.9882, 0.9922],
          "hex": "#fbfcfd"
        }
      },
      "100": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9765, 0.9804, 0.9882],
          "hex": "#f9fafc"
        }
      },
      "200": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8863, 0.9098, 0.9412],
          "hex": "#e2e8f0"
        }
      },
      "600": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2745, 0.3333, 0.4314],
          "hex": "#46556e"
        }
      },
      "$description": "Cool neutrals for text, borders and quiet surfaces."
    },
    "gray": {
      "500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.502, 0.502, 0.502],
          "hex": "#808080"
        },
        "$description": "CSS `grey` keyword."
      }
    },
    "red": {
      "100": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9725, 0.8431, 0.8549],
          "hex": "#f8d7da"
        }
      },
      "500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 0, 0],
          "hex": "#ff0000"
        }
      }
    },
    "green": {
      "100": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8549, 0.949, 0.8627],
          "hex": "#daf2dc"
        }
      },
      "500": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1333, 0.7333, 0.2],
          "hex": "#22bb33"
        }
      }
    },
    "black-alpha": {
      "50": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.5,
          "hex": "#000000"
        }
      },
      "$description": "Translucent black; the step is the alpha percentage."
    },
    "white-alpha": {
      "80": {
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 0.8,
          "hex": "#ffffff"
        }
      },
      "$description": "Translucent white; the step is the alpha percentage."
    }
  }
}
