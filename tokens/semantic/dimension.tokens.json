{
  "space": {
    "$type": "dimension",
    "gap": {
      "$description": "Distance between siblings.",
      "tight": {
        "$value": "{space.2xs}",
        "$description": "Icon next to its label."
      },
      "compact": { "$value": "{space.sm}" },
      "default": { "$value": "{space.md}" },
      "loose": { "$value": "{space.lg}" },
      "wide": { "$value": "{space.xl}" }
    },
    "inset": {
      "$description": "Padding inside a container.",
      "2xs": { "$value": "{space.2xs}" },
      "xs": { "$value": "{space.xs}" },
      "sm": { "$value": "{space.sm}" },
      "md": { "$value": "{space.md}" },
      "lg": { "$value": "{space.lg}" },
      "xl": { "$value": "{space.xl}" }
    },
    "section": {
      "$value": "{space.3xl}",
      "$description": "Vertical rhythm between page sections."
    },
    "gutter": {
      "page": {
        "$value": { "value": 1.5, "unit": "rem" },
        "$description": "Inline page padding: page-min until content reaches size.measure.page, then it grows so content stays that wide and centered. Uses 100vw rather than % so the value is the same at any nesting depth, letting full-bleed sections cancel it with a negative margin. Not aliased: Style Dictionary's outputReferences rebuilds a pure-reference value's CSS from the reference name, which would silently discard the $extensions escape below.",
        "$extensions": {
          "com.zubacapital.css": {
            "value": "max(var(--space-gutter-page-min), (100vw - var(--size-measure-page)) / 2)"
          }
        }
      },
      "page-min": {
        "$value": "{space.lg}",
        "$description": "Narrowest page gutter, below breakpoint.page."
      },
      "page-min-wide": {
        "$value": "{space.2xl}",
        "$description": "Page gutter minimum from breakpoint.page up. Custom properties can't change inside @media, so consumers switch --space-gutter-page-min to it themselves (see the Page gutter section of tokens/README.md)."
      },
      "container": { "$value": "{space.xl}" }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": {
      "$value": "{radius.md}",
      "$description": "Buttons, inputs, badges."
    },
    "card": { "$value": "{radius.lg}" },
    "panel": {
      "$value": "{radius.xl}",
      "$description": "Callouts and large content blocks."
    },
    "feature": {
      "$value": "{radius.2xl}",
      "$description": "Hero-scale surfaces."
    },
    "circle": { "$value": "{radius.pill}" }
  },
  "size": {
    "$type": "dimension",
    "icon": {
      "sm": { "$value": "{size.20}" },
      "md": { "$value": "{size.24}" }
    },
    "control": {
      "$description": "Square hit areas and icon tiles.",
      "md": { "$value": "{size.40}" },
      "lg": { "$value": "{size.50}" },
      "xl": { "$value": "{size.64}" }
    },
    "measure": {
      "$description": "Maximum content widths.",
      "dialog": { "$value": "{size.420}" },
      "narrow": { "$value": "{size.500}" },
      "text": { "$value": "{size.768}" },
      "prose": { "$value": "{size.960}" },
      "wide": { "$value": "{size.1200}" },
      "page": { "$value": "{size.1280}" }
    }
  }
}
