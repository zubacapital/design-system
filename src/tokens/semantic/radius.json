{
  "radius": {
    "semantic": {
      "sm": {
        "$type": "dimension",
        "$value": "{radius.primitive.sm}",
        "$extensions": { "zuba": { "cssName": "radius-sm" } }
      },
      "md": {
        "$type": "dimension",
        "$value": "{radius.primitive.md}",
        "$extensions": { "zuba": { "cssName": "radius-md" } }
      },
      "lg": {
        "$type": "dimension",
        "$value": "{radius.primitive.lg}",
        "$extensions": { "zuba": { "cssName": "radius-lg" } }
      },
      "xl": {
        "$type": "dimension",
        "$value": "{radius.primitive.xl}",
        "$extensions": { "zuba": { "cssName": "radius-xl" } }
      },
      "2xl": {
        "$type": "dimension",
        "$description": "New step. Fixes home.css hero CTA's previously hardcoded 2rem radius.",
        "$value": "{radius.primitive.2xl}",
        "$extensions": { "zuba": { "cssName": "radius-2xl" } }
      },
      "pill": {
        "$type": "dimension",
        "$value": "{radius.primitive.pill}",
        "$extensions": { "zuba": { "cssName": "radius-pill" } }
      }
    }
  }
}
