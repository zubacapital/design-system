{
  "color": {
    "semantic": {
      "backgroundBase": {
        "$type": "color",
        "$value": "{color.primitive.navy900}",
        "$extensions": { "zuba": { "cssName": "color-bg" } }
      },
      "backgroundSubtle": {
        "$type": "color",
        "$value": "{color.primitive.sky50}",
        "$extensions": { "zuba": { "cssName": "color-bg-light" } }
      },
      "brandPrimary": {
        "$type": "color",
        "$value": "{color.primitive.navy900}",
        "$extensions": { "zuba": { "cssName": "color-primary" } }
      },
      "accentSecondary": {
        "$type": "color",
        "$value": "{color.primitive.teal300}",
        "$extensions": { "zuba": { "cssName": "color-secondary" } }
      },
      "textDefault": {
        "$type": "color",
        "$value": "{color.primitive.slate600}",
        "$extensions": { "zuba": { "cssName": "color-text" } }
      },
      "borderDefault": {
        "$type": "color",
        "$value": "{color.primitive.slate200}",
        "$extensions": { "zuba": { "cssName": "color-border" } }
      },
      "white": {
        "$type": "color",
        "$value": "{color.primitive.white}",
        "$extensions": { "zuba": { "cssName": "color-white" } }
      },
      "black": {
        "$type": "color",
        "$value": "{color.primitive.black}",
        "$extensions": { "zuba": { "cssName": "color-black" } }
      },
      "statusDanger": {
        "$type": "color",
        "$value": "{color.primitive.red500}",
        "$extensions": { "zuba": { "cssName": "color-red" } }
      },
      "statusDangerBackground": {
        "$type": "color",
        "$value": "{color.primitive.red100}",
        "$extensions": { "zuba": { "cssName": "color-red-bg" } }
      },
      "statusSuccess": {
        "$type": "color",
        "$value": "{color.primitive.green500}",
        "$extensions": { "zuba": { "cssName": "color-success" } }
      },
      "statusSuccessBackground": {
        "$type": "color",
        "$value": "{color.primitive.green100}",
        "$extensions": { "zuba": { "cssName": "color-success-bg" } }
      },
      "statusActive": {
        "$type": "color",
        "$description": "Investment card 'active' badge. Previously hardcoded #338a99 with no token.",
        "$value": "{color.primitive.teal600}",
        "$extensions": { "zuba": { "cssName": "color-status-active" } }
      },
      "borderMuted": {
        "$type": "color",
        "$description": "Previously literal CSS 'grey' on investment cards. Kept distinct from borderDefault (materially darker).",
        "$value": "{color.primitive.grey500}",
        "$extensions": { "zuba": { "cssName": "color-border-muted" } }
      },
      "surfaceSubtle": {
        "$type": "color",
        "$description": "Consolidates home.css's #fbfcfd and howitworks.css's #f9fafc into one shared tint.",
        "$value": "{color.primitive.surfaceSubtle}",
        "$extensions": { "zuba": { "cssName": "color-surface-subtle" } }
      },
      "surfaceTranslucent": {
        "$type": "color",
        "$description": "Previously home.css's #ffffffcc (white baked with alpha into the hex). Expressed as a real DTCG alpha color.",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "alpha": 0.8
        },
        "$extensions": { "zuba": { "cssName": "color-surface-translucent" } }
      },
      "overlayScrim": {
        "$type": "color",
        "$description": "Modal backdrop scrim, previously duplicated as a literal rgba(0,0,0,0.5) in subscription.css, signup.css and contact-form.css.",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0, 0],
          "alpha": 0.5
        },
        "$extensions": { "zuba": { "cssName": "color-overlay-scrim" } }
      },
      "accentKlaro": {
        "$type": "color",
        "$description": "Klaro cookie-widget accent, kept distinct from accentSecondary (--color-secondary) since the two OKLCH values genuinely differ in lightness/chroma.",
        "$value": "{color.primitive.teal500}",
        "$extensions": { "zuba": { "cssName": "color-accent-klaro" } }
      }
    }
  }
}
