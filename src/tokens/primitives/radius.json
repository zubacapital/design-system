{
  "radius": {
    "primitive": {
      "sm": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
      "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
      "lg": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
      "xl": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
      "2xl": {
        "$type": "dimension",
        "$description": "New step, fixes home.css hero CTA's previously hardcoded 2rem/32px radius.",
        "$value": { "value": 32, "unit": "px" }
      },
      "pill": { "$type": "dimension", "$value": { "value": 999, "unit": "px" } }
    }
  }
}
