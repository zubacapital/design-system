{
  "spacing": {
    "primitive": {
      "2xs": {
        "$type": "dimension",
        "$value": { "value": 0.25, "unit": "rem" }
      },
      "xs": { "$type": "dimension", "$value": { "value": 0.5, "unit": "rem" } },
      "sm": {
        "$type": "dimension",
        "$value": { "value": 0.75, "unit": "rem" }
      },
      "md": { "$type": "dimension", "$value": { "value": 1, "unit": "rem" } },
      "lg": { "$type": "dimension", "$value": { "value": 1.5, "unit": "rem" } },
      "xl": { "$type": "dimension", "$value": { "value": 2, "unit": "rem" } },
      "2xl": { "$type": "dimension", "$value": { "value": 3, "unit": "rem" } },
      "3xl": { "$type": "dimension", "$value": { "value": 4, "unit": "rem" } }
    },
    "fluidPrimitive": {
      "xs": {
        "$type": "fluidDimension",
        "$description": "Non-standard $type: DTCG's dimension type is a single value-plus-unit term, not an expression. This is a deliberate spec deviation for fluid/calc() values, matching insights.css's post-grid gap.",
        "$value": "calc(1rem + 0.1vw)"
      },
      "sm": {
        "$type": "fluidDimension",
        "$description": "See xs above for the fluidDimension deviation note.",
        "$value": "calc(1rem + 0.5vw)"
      },
      "md": {
        "$type": "fluidDimension",
        "$description": "See xs above. Matches the site's previous --padding-inline.",
        "$value": "calc(1rem + 1vw)"
      },
      "lg": {
        "$type": "fluidDimension",
        "$description": "See xs above. References the sm spacing primitive for its fixed term.",
        "$value": "calc({spacing.primitive.sm} + 5vw)"
      }
    }
  }
}
